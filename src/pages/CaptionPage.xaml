<Page
    x:Class="LiveCaptionsTranslator.CaptionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:LiveCaptionsTranslator"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:utils="clr-namespace:LiveCaptionsTranslator.utils"
    Title="CaptionPage"
    JournalEntry.KeepAlive="True"
    ScrollViewer.CanContentScroll="False"
    mc:Ignorable="d">
    <!--  CanContentScroll=False stops NavigationView from wrapping the page in its own ScrollViewer, which gave CaptionScroll infinite height.  -->

    <Page.Resources>
        <!--  No BasedOn: the WPF-UI input styles add borders, padding and a focus underline that a caption does not want.  -->
        <Style x:Key="OriginalTextStyle" TargetType="RichTextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="FontSize" Value="{DynamicResource OriginalFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="ToolTip" Value="Ctrl+Scroll to Resize Font" />
        </Style>
        <Style x:Key="TranslatedTextStyle" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="FontSize" Value="{DynamicResource TranslatedFontSize}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="ToolTip" Value="Ctrl+Scroll to Resize Font" />
        </Style>
    </Page.Resources>

    <!--  Finished sentences oldest first, the sentence being spoken last; follows the newest while scrolled to the bottom.  -->
    <ScrollViewer
        x:Name="CaptionScroll"
        Margin="5,5,5,5"
        Padding="8,4,12,4"
        ScrollChanged="CaptionScroll_ScrollChanged"
        VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <ItemsControl x:Name="LogCards" ItemsSource="{Binding LogEntries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <RichTextBox
                                Grid.Column="0"
                                PreviewMouseWheel="OriginalCard_PreviewMouseWheel"
                                Style="{StaticResource OriginalTextStyle}"
                                utils:Furigana.Text="{Binding SourceText, Mode=OneWay}" />
                            <Border
                                Grid.Column="1"
                                Width="1"
                                Margin="12,0"
                                Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            <TextBox
                                Grid.Column="2"
                                PreviewMouseWheel="TranslatedCard_PreviewMouseWheel"
                                Style="{StaticResource TranslatedTextStyle}"
                                Text="{Binding TranslatedText, Mode=OneWay}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <RichTextBox
                    Grid.Column="0"
                    PreviewMouseWheel="OriginalCard_PreviewMouseWheel"
                    Style="{StaticResource OriginalTextStyle}"
                    utils:Furigana.Text="{Binding DisplayOriginalCaption, Mode=OneWay}" />
                <Border
                    Grid.Column="1"
                    Width="1"
                    Margin="12,0"
                    Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                <TextBox
                    Grid.Column="2"
                    PreviewMouseWheel="TranslatedCard_PreviewMouseWheel"
                    Style="{StaticResource TranslatedTextStyle}"
                    Text="{Binding DisplayTranslatedCaption, Mode=OneWay}" />
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
